<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="639.0" prefWidth="835.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafeteriaapp.resources.controllers.OrderHistoryController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="835.0" spacing="15.0" style="-fx-background-color: #A52A2A;" BorderPane.alignment="CENTER">
         <children>
            <FontAwesomeIconView style="-fx-cursor: hand;" fill="WHITE" glyphName="ARROW_LEFT" onMouseClicked="#handleBackToHome" size="20.0" />
            <Label text="Order History" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets left="25.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #F5F5DC;" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="ordersContainer" spacing="15.0" style="-fx-background-color: #F5F5DC;">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>