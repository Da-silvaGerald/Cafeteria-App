<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cafeteriaapp.resources.controllers.ManagerDashboardController" style="-fx-background-color: #A52A2A;">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Cafeteria Manager Dashboard" />

    <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="250.0" text="Item Name" />
            <TableColumn fx:id="colCategory" prefWidth="150.0" text="Category" />
            <TableColumn fx:id="colQty" prefWidth="100.0" text="Stock Qty" />
            <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price (₦)" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <VBox spacing="15.0" style="-fx-background-color: #F5F5DC; -fx-padding: 15; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-radius: 5;">
        
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Manage Menu Item" />
        
        <GridPane hgap="15.0" vgap="15.0">
            <Label text="Item Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" prefWidth="250.0" promptText="e.g. Jollof Rice" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Category:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="categoryField" prefWidth="200.0" promptText="e.g. Main Meal" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            
            <Label text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="qtyField" promptText="e.g. 50" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Price (₦):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="priceField" promptText="e.g. 1500.00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            
            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextArea fx:id="descArea" prefHeight="60.0" promptText="Brief description of the food item..." wrapText="true" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button mnemonicParsing="false" onAction="#clearFields" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Clear Form" />
            <Button mnemonicParsing="false" onAction="#handleDeleteItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Delete Item" />
            <Button mnemonicParsing="false" onAction="#handleUpdateItem" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Update Item" />
            <Button mnemonicParsing="false" onAction="#handleAddItem" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Add New Item" />
        </HBox>
    </VBox>

</VBox>
